# Backend — Environment Variables
# Copy to .env and edit as needed:
#   cp .env.example .env
#
# CONVENTION, and it is load-bearing: a variable here is either assigned a real
# value or left COMMENTED OUT. Never write a bare `NAME=`.
#
# An empty assignment is not the same as "unset". It is a set value that
# happens to be empty, so `os.getenv("NAME", "a-default")` returns "" and the
# default never fires. That bit for real: `KARAOKE_DEMUCS_PYTHON=` made
# `os.path.abspath("")` resolve to the backend DIRECTORY, and because a
# directory does exist, the `if not DEMUCS_PYTHON.exists()` guard written to
# catch exactly this misconfiguration was silently satisfied — so separation
# failed later with an opaque spawn error instead of the clear warning.
#
# It was harmless while nothing read this file. It stopped being harmless the
# moment `cp .env.example .env` began to work, which is why every empty
# assignment here is now commented out. A test enforces it
# (tests/test_dotenv_loading.py::test_the_example_file_assigns_no_empty_values).

# -----------------------------------------------
# Server
# -----------------------------------------------

# Public base URL (used to build stem file URLs)
BASE_URL=http://localhost:8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated origins allowed by CORS middleware
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Only if you run the backend behind a reverse proxy. Which upstream addresses
# are trusted to set X-Forwarded-For. Set it to the PROXY'S OWN ADDRESS.
#
# *** THIS ONE DOES NOT WORK FROM THIS FILE. *** It belongs in the PROCESS
# environment — systemd `Environment=`, your shell, or `--forwarded-allow-ips`
# on the uvicorn command line. uvicorn reads it while constructing its config,
# which happens before the app package is imported and therefore before this
# file is loaded, so a value set here is silently ignored. It is documented
# here anyway because this is where people look for it, and finding nothing is
# what leads to setting it in the wrong place.
#
# Getting it wrong is quiet and expensive in both directions. Too narrow (the
# common case: set here, so uvicorn keeps the 127.0.0.1 default and never
# trusts your proxy) and every request appears to come FROM the proxy, so the
# per-network rate limiting collapses the whole user base onto one key — at
# the default GATE_RATE_MAX=5, five bad gate attempts lock out everyone.
#
# Too wide — `*` — and the client address is taken from a header the client
# writes, so anyone can vary it per request and walk around the rate limits.
# The backend warns at startup if it sees `*`, but only for a value that
# reached the process environment; it cannot see one set here.
# FORWARDED_ALLOW_IPS=127.0.0.1

# -----------------------------------------------
# Database
# -----------------------------------------------

# SQLite (default). Prefix with sqlite+aiosqlite://
DATABASE_URL=sqlite+aiosqlite:///./karaoke.db

# Set to "true" to log all SQL statements
SQL_ECHO=false

# Whether startup brings the database up to the current schema by itself.
# Default: true — a fresh install and an upgrade both just work.
#
# Set to false if you would rather migrate deliberately (a backup first, say).
# It is an opt-OUT of unattended migration at startup, not a lock on the tool:
# startup then mutates nothing and REFUSES TO SERVE if the schema is behind,
# telling you to run `kb-db upgrade --yes`, which still works.
# KARAOKE_DB_AUTO_MIGRATE=false

# -----------------------------------------------
# File storage
# -----------------------------------------------

# Temporary upload directory
UPLOADS_DIR=uploads

# Processed stems output directory
STEMS_DIR=stems

# Maximum upload file size (MB)
MAX_FILE_SIZE_MB=500

# -----------------------------------------------
# Session / auth
# -----------------------------------------------

# Secret that signs the session cookie. Set a long random value in production
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# If unset, the backend persists one to SESSION_SECRET_FILE (below) so sessions
# survive a restart; only if that file is unwritable does it fall back to a
# per-process ephemeral secret (sessions reset on restart).
# SESSION_SECRET=

# Where the auto-generated secret is stored when SESSION_SECRET is unset.
# Default: `.session_secret` in the sqlite DB's directory (else the backend
# working directory). Mode 0600, gitignored — never commit it.
# SESSION_SECRET_FILE=

# Session cookie name. Neutral default; override per deployment. NOTE: renaming
# this logs out every existing session on the next restart.
SESSION_COOKIE=karaoke_session

# Set to "true" to only send the session cookie over HTTPS (enable in prod).
SESSION_HTTPS_ONLY=false

# Session lifetime in seconds (default: 14 days).
SESSION_MAX_AGE=1209600

# Authentication mode: single_host (core; optional shared gate password) or
# multi_user (premium; accounts + invites). Unset = auto-detect (multi_user
# when the premium package is installed, else single_host).
# AUTH_MODE=

# Single-host gate password (single_host mode only). Unset = no gate, the LAN
# is open. Set KARAOKE_GATE_PASSWORD_HASH (bcrypt) OR KARAOKE_GATE_PASSWORD
# (plaintext); the hash wins when both are set.
# KARAOKE_GATE_PASSWORD=
# KARAOKE_GATE_PASSWORD_HASH=

# Gate unlock rate limit: max attempts (GATE_RATE_MAX) per window seconds
# (GATE_RATE_WINDOW). Defaults: 5 attempts / 60 s.
GATE_RATE_MAX=5
GATE_RATE_WINDOW=60

# -----------------------------------------------
# Worker / model paths (defaults are cwd-relative to backend/)
# -----------------------------------------------

# Python interpreter of the demucs/audio-separator venv used for local
# separation + heart transcription (default: .venv-demucs/bin/python).
# KARAOKE_DEMUCS_PYTHON=

# Directory of audio-separator model weights (default:
# ckpt/audio-separator-models).
# AUDIO_SEPARATOR_MODEL_DIR=

# HeartTranscriptor checkpoint dir (default: ckpt/HeartTranscriptor-oss).
# KARAOKE_HEART_CKPT=

# Pass 1 model — splits vocals from instrumental (default: mdx_extra).
# DEMUCS_MODEL=mdx_extra

# Pass 2 model — splits lead from backing vocals. Default:
# mel_band_roformer_karaoke_aufr33_viperx_sdr_10.1956.ckpt
# Pass 2 is treated as non-fatal: if the model will not load, you get the full
# vocal as lead and a silent backing stem rather than a failed job.
#
# This is the DEFAULT, not the only option. An uploader can pick a different
# Pass-2 model per song from the allowlist in
# backend/src/karaoke_backend/workers/karaoke_models.py; the "roformer" choice
# there means "whatever this variable says", so setting it still moves the
# default for every upload that does not pick something else.
# KARAOKE_MODEL=

# Name of an installed separator PLUGIN to use instead of the built-in
# local/remote/Modal dispatch. Unset (the default) uses the built-in path.
# A name that is missing or disabled logs a warning and falls back to the
# built-in dispatch — this variable can never silently turn separation off.
# KARAOKE_SEPARATOR=

# -----------------------------------------------
# Job queue
# -----------------------------------------------
# Every value below fails safe: a non-numeric or below-minimum setting logs a
# warning and falls back to THE DEFAULT — not to the minimum — rather than
# failing to start. So a deliberate 0 does not get you the smallest legal
# value, it gets you the default.

# Jobs one worker runs at once (default: 1). The default is also the guard
# against running two GPU separations concurrently and exhausting VRAM — raise
# it only if you know your hardware can take it.
# KARAOKE_JOB_CONCURRENCY=1

# How long a claimed job stays claimed before another worker may take it over,
# in seconds (default: 180, minimum 1). Must exceed your longest plausible
# stall, or a job still running gets picked up twice.
# KARAOKE_JOB_LEASE_SECONDS=180

# Attempts before a job is given up on (default: 2, minimum 1).
# KARAOKE_JOB_MAX_ATTEMPTS=2

# Idle poll interval in seconds (default: 2, minimum 0.05). This sleep is the
# only brake on the idle loop; the floor exists because 0 turns the worker into
# a spin of SELECT+UPDATE against the same SQLite file serving requests.
# KARAOKE_JOB_POLL_SECONDS=2

# -----------------------------------------------
# Catalog provider plugins (self-hoster extension point)
# -----------------------------------------------

# Directory of single-file CatalogProvider modules to load at startup, in
# addition to any installed provider plugin wheels. Left unset by default;
# core ships zero providers.
# KARAOKE_PROVIDERS_DIR=

# Restricts which installed CATALOG provider plugins load from entry points.
# Unset (default) loads all of them; `none` skips catalog entry-point discovery;
# a comma-separated list (lowercase — the value is lowercased before matching)
# loads only the named ones.
#
# Its reach is narrower than it looks, so do not use it as a containment
# measure: it does NOT affect modules loaded from KARAOKE_PROVIDERS_DIR above,
# nor the transcriber, separator, lyrics-provider or API-router plugin groups.
# Those load regardless of what is set here.
# KARAOKE_PROVIDERS=none

# Guest import: whether someone who joined the show may run an import against
# a provider you have configured with your own account. Both variables below
# can only ever SUBTRACT — there is no value that grants this.
#
# A provider must declare the capability in its own code to allow it at all, so
# anything already installed is host-only until its author opts in. The switch
# is deliberately one-way: what would be granted is the ability for whoever
# walked into the room to spend money on your account, and that should take
# editing a provider, not editing a config file.
#
# `off` here disables guest import for every provider:
# KARAOKE_GUEST_IMPORT=off
#
# Or disable exactly one, by provider name uppercased with every run of
# non-alphanumeric characters collapsed to a single underscore (a provider
# named `my-catalog` becomes KARAOKE_GUEST_IMPORT_MY_CATALOG):
# KARAOKE_GUEST_IMPORT_<PROVIDER>=off

# -----------------------------------------------
# Third-party lyrics lookup (opt-in, OFF by default)
# -----------------------------------------------

# Enables the built-in lrclib.net lyrics provider. Unset — the shipped
# default — means OFF: nothing in this install contacts lrclib.net, ingest
# aligns without reference lyrics, GET /api/lyrics answers 503, and the
# editor's "lrclib" re-sync mode is hidden.
#
# Accepted values: 1, true, yes, on. Anything else (including a typo) is OFF,
# by design — reaching a third-party lyrics service should take a deliberate
# act, not a near-miss in a config file.
#
# Pasting your own reference lyrics is unaffected and needs no flag.
# KARAOKE_LRCLIB=

# -----------------------------------------------
# Plex media-server library source
# -----------------------------------------------
# Import songs from a Plex music library you run yourself. Nothing here
# searches for or acquires music: it reads a collection you already have, on a
# server whose address you type in, and copies the file into this install so it
# can be separated like any other upload. Your library file is only ever read.
#
# Normally you configure this in the app (host sidebar → 🎞). Setting either of
# the two variables below pins it from the environment instead — useful when a
# compose file owns the configuration — and makes the in-app fields read-only.
# KARAOKE_PLEX_URL=http://plex.lan:32400
# KARAOKE_PLEX_TOKEN=

# Where the token is stored when it is NOT pinned above. The token is a
# credential for your whole media library, so it never goes in the database:
# it is written to this path at mode 0600. Default: `.plex_token` in the same
# directory as the sqlite DB (the same rule the session secret follows).
# PLEX_TOKEN_FILE=

# Path rewrites, `plex-prefix=>local-prefix`, separated by `;`. Only needed
# when this install and the media server disagree about where the library
# lives — e.g. Plex reports /media/... and the same files are at /srv/music/...
# here. Unset (the default) means the reported path is used as-is; getting it
# wrong is not dangerous, the import just falls back to streaming the track
# from the server.
# KARAOKE_PLEX_PATH_MAP=/media=>/srv/music

# Opt-in: use lyrics stored on the Plex server as an alignment reference.
# Unset — the shipped default — means OFF, and no lyric text is ever read off
# the server; importing the AUDIO is unaffected and needs no flag.
#
# Off by default because the two are different questions. A track's audio is
# your own file. A track's lyrics on a media server may have been populated
# from a licensed metadata supplier, and whether that text may be reused in a
# second application is a call for the person who knows where it came from.
#
# Accepted values: 1, true, yes, on. Anything else (including a typo) is OFF.
# KARAOKE_PLEX_LYRICS=

# -----------------------------------------------
# Optional LLM assist for lyric transcription (opt-in, OFF by default)
# -----------------------------------------------
# Points at an OpenAI-compatible endpoint used to clean up transcribed lyrics.
# Unset — the shipped default — means OFF, and nothing here contacts any
# endpoint. Point it wherever you like, including a model running on your own
# machine; the default model name is literally `local`.
#
# Note what this sends: the LYRIC TEXT goes to whatever endpoint you name.
# Anything other than a local endpoint means that text leaves this machine.
#
# Setting these makes the feature AVAILABLE, not automatic: the per-request
# toggle in the UI still decides whether any given job uses it.
# KARAOKE_LLM_BASE_URL=http://127.0.0.1:8080/v1
# KARAOKE_LLM_MODEL=local

# Request timeout in seconds (default: 600). Long by design — this can be a
# large local model on CPU.
# KARAOKE_LLM_TIMEOUT=600

# API key, if your endpoint wants one. Prefer the _FILE form: it keeps the
# secret out of this file and out of `ps`/`systemctl show` output. Chmod the
# file 0600 — nothing here checks its permissions for you.
#
# If the endpoint is not on this machine, use https://. An API key sent to an
# http:// endpoint is on the wire in clear text.
# KARAOKE_LLM_API_KEY=
# KARAOKE_LLM_API_KEY_FILE=/etc/karaoke/llm-api-key

# -----------------------------------------------
# Acoustic word timing (ON by default, CUDA only)
# -----------------------------------------------
# After alignment, every word of a lyrics-referenced run (plain or synced) is
# re-timed against the vocal stems by several CTC acoustic models, run in the
# processing Python (KARAOKE_PROCESSING_PYTHON / KARAOKE_DEMUCS_PYTHON). Text
# never changes; any failure keeps the previous timing and records why in the
# lyrics set's metadata. The first run downloads about 7.5 GB of model weights.
# See "Acoustic Word Timing" in README.md.
#
# 0, false, off or no disables it. Anything else (including unset) is ON.
# KARAOKE_ACOUSTIC_ALIGNMENT=

# Allow it to run on the CPU when there is no CUDA device (slow; default off,
# in which case runs without CUDA keep the previous timing).
# KARAOKE_ACOUSTIC_ALIGNMENT_CPU=

# Worker time limit in seconds (default: 3600). Includes the first-run model
# download; a warm run on a GPU takes well under a minute per song.
# KARAOKE_ACOUSTIC_ALIGNMENT_TIMEOUT=3600

# -----------------------------------------------
# Offloading GPU work to another machine (both OFF by default)
# -----------------------------------------------
# Separation AND Heart transcription both run locally unless you turn one of
# these on. Be precise about what that means: turning one on uploads the audio
# to that machine, and for transcription it uploads the separated VOCAL track.
#
# Both destinations are YOUR OWN infrastructure — a box you have SSH access to,
# or a Modal account you set up and pay for. Nothing here routes work through
# us; we operate nothing in either path.

# -- Modal (GPU work on your own Modal account) --
# The on-switch. Accepted values: 1, true, yes, on. Anything else is OFF.
# It also needs the `modal` SDK installed in the backend venv; without it this
# logs a warning and falls back to remote/local rather than failing.
# KARAOKE_MODAL=1

# Modal app name to call (default: karaoke-gpu).
# KARAOKE_MODAL_APP=karaoke-gpu

# GPU class your deployed app provisions — this is the cost knob.
# Default: T4. Others: L4, A10G, A100, ...
# KARAOKE_MODAL_GPU=T4

# IMPORTANT — deploy time vs. run time. KARAOKE_MODAL_APP, KARAOKE_MODAL_GPU
# and KARAOKE_MODEL are ALSO read by `modal deploy` (modal_app.py), which runs
# in its own process that never imports this backend and so never reads this
# file. Setting them here changes only the client side — the side that calls
# out. To change what is actually deployed, set them in the SHELL you run
# `modal deploy` from, and keep the two in agreement: an app name that differs
# between the two means the lookup simply fails to find the deployed app.

# Modal credentials do not belong in this file. Run `modal setup`, or set
# MODAL_TOKEN_ID / MODAL_TOKEN_SECRET in the process environment.
# See: https://modal.com/docs/guide/secrets

# -- Remote worker (separation over SSH on a machine you own) --
# The on-switch: an SSH destination, as you would type it after `ssh`. Unset
# (default) means OFF. Key-based auth only — nothing prompts for a password.
# KARAOKE_REMOTE_HOST=user@gpu-box.lan

# Directory on that machine holding the worker (default: karaoke-worker,
# relative to the remote login directory).
# KARAOKE_REMOTE_DIR=karaoke-worker

# Python interpreter there. Default: `.venv/bin/python` inside KARAOKE_REMOTE_DIR.
# KARAOKE_REMOTE_PYTHON=
